EOA_LLM_MODEL=gemini-2.5-flash
EOA_LLM_API_KEY=
GEMINI_API_KEY=
EOA_AGENT_MAX_TOOL_CALLS=8
EOA_AGENT_TIMEOUT_S=45

# Agamotto Observability & Internal Auth
AGAMOTTO_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
AI_SERVICE_INTERNAL_KEY=
PORT=8000
